# Which brain the Alexa+ simulator uses: auto | bedrock | ollama | rules
NOVA_LLM=auto

# Amazon Bedrock (Amazon Nova models). Uses the normal AWS credential chain
# (AWS_PROFILE, env keys, SSO) or a Bedrock API key in AWS_BEARER_TOKEN_BEDROCK.
AWS_REGION=us-east-1
# Optional: force a model / inference profile id
# NOVA_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Optional local fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Where the MCP server listens and where the simulator finds it
NOVA_MCP_HOST=127.0.0.1
NOVA_MCP_PORT=8765
NOVA_MCP_URL=http://127.0.0.1:8765/mcp
SIMULATOR_PORT=8080

# Optional: pin the household clock for a demo recording (HH:MM, keeps ticking)
# NOVA_CLOCK=08:20

# Demo-only routes (/demo/reset, POST /demo/clock). Turn off for any deployed server.
NOVA_DEMO=1
# Shared secret for the simple door-sensor webhook and the "Sync from Ring" control
NOVA_RING_SECRET=nova-demo-ring

# Ring Partner API (https://api.amazonvision.com). Choose ONE:
# 1) A ~30-minute access token: Ring Developer Playground -> Generate Token
#    https://developer.amazon.com/ring/console/playground
# RING_ACCESS_TOKEN=
# 2) Production: a refresh token from Ring account linking, plus your app's client credentials
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# How often Nova backfills from the event history API when linked (seconds)
# RING_POLL_SECONDS=300
# Key Ring signs webhooks with (X-Signature: sha256=HMAC of the raw body)
# NOVA_RING_SIGNING_KEY=
